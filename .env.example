# Optional overrides for `docker compose` (copy to .env; never commit .env).

# Host port for MongoDB. Default 27018. Change it if another MongoDB already uses 27018.
GEO_TREE_MONGO_HOST_PORT=27018

# Host port for the FastAPI backend container.
GEO_TREE_API_HOST_PORT=8000

# development seeds admin@gmail.com / admin123 if missing. Anything else requires GEO_TREE_JWT_SECRET.
GEO_TREE_ENVIRONMENT=development
GEO_TREE_JWT_SECRET=
