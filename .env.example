# Optional overrides for `docker compose` (copy to .env; never commit .env).

# Host port for MongoDB. Default 27018. Change it if another MongoDB already uses 27018.
GEO_TREE_MONGO_HOST_PORT=27018

# Host port for the FastAPI backend container.
GEO_TREE_API_HOST_PORT=8000

# development seeds admin@gmail.com / admin123 if missing. Anything else requires GEO_TREE_JWT_SECRET.
GEO_TREE_ENVIRONMENT=development
GEO_TREE_JWT_SECRET=

# Leaf assessment (DINOv2) tuning for the local backend. Defaults suit a Ryzen 5 / 16 GB PC on CPU.
# DINOV2_MODEL=dinov2_vits14          # dinov2_vitb14 only as an explicit experiment
# DINOV2_DEVICE=auto                  # auto | cpu | cuda (CPU fallback is automatic)
# DINOV2_IMAGE_SIZE=336               # multiple of 14; changing it re-computes cached features
# DINOV2_BATCH_SIZE=4
# DINOV2_NUM_WORKERS=0
# AI_MIN_IMAGES_PER_CLASS=10
# AI_VALIDATION_FRACTION=0.2
# AI_RETRAIN_DEBOUNCE_SECONDS=15
# AI_CONFIDENCE_THRESHOLD=0.6         # below this a result is shown as "uncertain"
