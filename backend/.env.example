# Copy to backend/.env for local runs (never commit .env).
ENVIRONMENT=development

# FastAPI on Windows talking to the Docker MongoDB via the published host port.
# Inside Docker Compose this is overridden to mongodb://mongodb:27017.
MONGO_URI=mongodb://localhost:27018
MONGO_DATABASE=geo_tree

# Required outside development. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=10080

# Development-only admin, seeded only when ENVIRONMENT=development and missing.
SEED_DEV_ADMIN=true
DEV_ADMIN_EMAIL=admin@gmail.com
DEV_ADMIN_PASSWORD=admin123
